.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #409eff 0%, #67c23a 100%);
  padding: 40rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  margin-bottom: 30rpx;
}

.logo-icon {
  font-size: 120rpx;
}

.title {
  display: block;
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.form-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: #409eff;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}