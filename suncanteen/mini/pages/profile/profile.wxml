<view class="page-container">
  <view class="user-section">
    <view class="user-info">
      <text class="user-icon">👤</text>
      <view class="info-text">
        <text class="user-name">{{ user.real_name }}</text>
        <text class="user-username">{{ user.username }}</text>
      </view>
    </view>
  </view>
  <view class="menu-section">
    <view class="menu-item" bindtap="goToChangePassword">
      <text class="menu-icon">🔐</text>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于系统</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  <button class="btn-logout" bindtap="handleLogout">退出登录</button>
</view>