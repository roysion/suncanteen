.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.user-section {
  background: linear-gradient(180deg, #409eff 0%, #67c23a 100%);
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-icon {
  font-size: 80rpx;
  margin-right: 30rpx;
}

.info-text {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.user-username {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.menu-section {
  background: #fff;
  margin: 0 20rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.btn-logout {
  width: calc(100% - 40rpx);
  margin: 0 20rpx;
  height: 88rpx;
  background: #f56c6c;
  color: #fff;
  border-radius: 15rpx;
  font-size: 32rpx;
}